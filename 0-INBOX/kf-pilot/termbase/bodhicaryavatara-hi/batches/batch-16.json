  "examples": [
   {
    "id": "1-9",
    "bo": "བྱང་ཆུབ་སེམས་སྐྱེས་གྱུར་ན་སྐད་ཅིག་གིས། ། འཁོར་བའི་བཙོན་རར་བསྡམས་པའི་ཉམ་ཐག་རྣམས། ། བདེ་གཤེགས་རྣམས་ཀྱི་སྲས་ཞེས་བརྗོད་བྱ་ཞིང་། ། འཇིག་རྟེན་ལྷ་མིར་བཅས་པས་ཕྱག་བྱར་འགྱུར། །",
    "gemini_zero_shot": "बोधिचित्त उत्पन्न होते ही क्षण भर में,\nसंसार के कारागार में बंधे हुए दीन प्राणी,\nसुगतों के पुत्र कहलाते हैं,\nऔर देवों तथा मनुष्यों सहित लोक के वंदनीय हो जाते हैं।"
   },
   {
    "id": "7-13",
    "bo": "བརྩོན་མེད་འབྲས་བུ་འདོད་པ་དང་། ། བཟེ་རེ་ཅན་ལ་གནོད་མང་ཞིང་། ། འཆི་བས་བཟུང་བཞིན་ལྷ་འདྲ་བ། ། ཀྱི་ཧུད་སྡུག་བསྔལ་དག་གིས་བཅོམ། །",
    "gemini_zero_shot": "बिना प्रयास के फल की कामना करने वाले,\nकायर व्यक्ति को अनेक कष्ट होते हैं,\nमृत्यु द्वारा पकड़े जाने पर भी देवों के समान आचरण करने वाले,\nहा! तुम दुःखों द्वारा नष्ट कर दिए जाओगे।"
   },
   {
    "id": "8-124",
    "bo": "གལ་ཏེ་བྱིན་ན་ཅི་སྤྱད་ཅེས། ། བདག་དོན་སེམས་པ་འདྲེ་ཡི་ཚུལ། ། གལ་ཏེ་སྤྱད་ན་ཅི་སྦྱིན་ཅེས། ། གཞན་དོན་སེམས་པ་ལྷ་ཡི་ཆོས། །",
    "gemini_zero_shot": "'यदि दे दिया तो मैं क्या उपभोग करूँगा?'\nस्वार्थ का चिन्तन करना प्रेत का स्वभाव है।\n'यदि उपभोग किया तो मैं क्या दूँगा?'\nपरार्थ का चिन्तन करना देव का धर्म है।"
   }
  ]
 },
