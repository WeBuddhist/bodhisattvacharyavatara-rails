    "bo": "ཀུན་ནས་དྲན་པའི་ཐག་པ་ཡིས། ། སེམས་ཀྱི་གླང་པོ་དམ་བཏགས་ན། ། འཇིགས་པ་ཐམས་ཅད་མེད་འགྱུར་ཞིང་། ། དགེ་བ་ཐམས་ཅད་ལག་ཏུ་འོང་། །",
    "gemini_zero_shot": "स्मृति रूपी रज्जु से सब ओर,\nयदि चित्त रूपी हाथी को दृढ़ता से बाँध दिया जाए,\nतो सभी भय समाप्त हो जाएँगे,\nऔर सभी कुशल हस्तगत हो जाएँगे।"
   },
   {
    "id": "5-25",
    "bo": "ཤེས་བཞིན་མེད་པའི་སེམས་ལྡན་པའི། ། ཐོས་དང་བསམས་དང་བསྒོམས་པ་ཡང་། ། གློ་རྡོལ་བུམ་པའི་ཆུ་བཞིན་དུ། ། དྲན་པ་ལ་ནི་དེ་མི་གནས། །",
    "gemini_zero_shot": "सम्प्रजन्य-रहित चित्त वालों के,\nश्रवण, मनन और भावना भी,\nछिद्रयुक्त घड़े के जल की भाँति,\nस्मृति में नहीं टिक पाते हैं।"
   },
   {
    "id": "9-23",
    "bo": "གལ་ཏེ་རང་རིག་ཡོད་མིན་ན། ། རྣམ་ཤེས་དྲན་པར་ཇི་ལྟར་འགྱུར། ། གཞན་མྱོང་བ་ན་འབྲེལ་པ་ལས། ། དྲན་འགྱུར་བྱི་བའི་དུག་བཞིན་ནོ། །",
    "gemini_zero_shot": "यदि स्वसंवेदन विद्यमान नहीं है,\nतो विज्ञान का स्मरण कैसे होगा?\nअन्य के अनुभव से सम्बन्ध होने के कारण,\nस्मरण होता है, चूहे के विष की भाँति।"
   }
  ]
 },
