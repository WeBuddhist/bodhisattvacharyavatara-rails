  ],
  "examples": [
   {
    "id": "4-35",
    "bo": "འཁོར་བའི་བཅོན་རའི་སྲུང་མས་དམྱལ་སོགས་སུ། ། གསོད་བྱེད་གཤེད་མར་གྱུར་པ་འདི་དག་ནི། ། གལ་ཏེ་བློ་གནས་ཆགས་པའི་དྲ་བ་ན། ། གནས་ན་བདག་ལ་བདེ་བ་ག་ལ་ཡོད། །",
    "gemini_zero_shot": "संसाररूपी कारागार के रक्षक और नरक आदि में,\nवधिक का कार्य करने वाले ये,\nयदि मेरे चित्त में स्थित आसक्ति के जाल में,\nनिवास करते हैं, तो मुझे सुख कहाँ से मिल सकता है?"
   },
   {
    "id": "8-5",
    "bo": "མི་རྟག་སུ་ཞིག་མི་རྟག་ལ། ། ཡང་དག་ཆགས་པར་བྱེད་པ་ཡོད། ། དེས་ནི་ཚེ་རབས་སྟོང་ཕྲག་ཏུ། ། སྡུག་པ་མཐོང་བར་ཡོང་མི་འགྱུར། །",
    "gemini_zero_shot": "कौन अनित्य प्राणी अनित्य विषयों में,\nसम्यक् रूप से आसक्त होता है?\nवह तो सहस्रों जन्मों तक,\nप्रिय का दर्शन नहीं कर पाएगा।"
   },
   {
    "id": "8-50",
    "bo": "གང་ལ་གཡོགས་ཀྱང་འདི་ཆགས་པ། ། དེ་མ་གཡོགས་ན་ཅིས་མི་འདོད། ། དེ་ལ་དགོས་པ་མེད་ན་ནི། ། གཡོགས་པ་ལ་ནི་ཅི་ཕྱིར་འཁྱུད། །",
    "gemini_zero_shot": "ढके होने पर भी यदि तुम्हें इससे राग है,\nतो अनावृत होने पर तुम इसे क्यों नहीं चाहते?\nयदि तुम्हें उसका कोई प्रयोजन नहीं है,\nतो ढके हुए का आलिङ्गन क्यों करते हो?"
   }
  ]
 },
