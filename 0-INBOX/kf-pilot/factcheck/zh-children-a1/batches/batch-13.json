 },
 {
  "id": "7-54",
  "tibetan": "དེ་བས་སེམས་ནི་བརྟན་པ་ཡིས། ། ལྟུང་བ་རྣམས་ནི་གཞོམ་བྱ་སྟེ། ། བདག་ནི་ལྟུང་བས་ཕམ་བྱས་ན། ། ཁམས་གསུམ་རྒྱལ་འདོད་བཞད་གད་འགྱུར། །",
  "academic_translation": "故當以堅定之心，\n摧毀一切諸墮罪；\n我若被墮罪擊敗，\n欲勝三界成笑柄。",
  "locked_terms": [
