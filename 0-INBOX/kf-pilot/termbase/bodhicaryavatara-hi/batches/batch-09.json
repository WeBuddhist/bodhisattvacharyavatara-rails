  "examples": [
   {
    "id": "1-22",
    "bo": "སེམས་ཅན་རེ་རེའི་མི་བདེ་བ། ། དཔག་ཏུ་མེད་པ་བསལ་འདོད་ཅིང་། ། རེ་རེའང་ཡོན་ཏན་དཔག་མེད་དུ། ། བསྒྲུབ་པར་འདོད་པ་སྨོས་ཅི་དགོས། །",
    "gemini_zero_shot": "तो प्रत्येक प्राणी के दुःखों को\nजो अपरिमेय रूप से दूर करना चाहता है,\nऔर प्रत्येक को अपरिमेय गुणों से\nसम्पन्न करना चाहता है, उसके विषय में तो कहना ही क्या?"
   },
   {
    "id": "2-1",
    "bo": "རིན་ཆེན་སེམས་དེ་གཟུང་བར་བྱ་བའི་ཕྱིར། ། དེ་བཞིན་གཤེགས་པ་རྣམས་དང་དམ་པའི་ཆོས། ། དཀོན་མཆོག་དྲི་མ་མེད་དང་སངས་རྒྱས་སྲས། ། ཡོན་ཏན་རྒྱ་མཚོ་རྣམས་ལ་ལེགས་པར་མཆོད། །",
    "gemini_zero_shot": "उस रत्न-तुल्य चित्त को ग्रहण करने के लिए,\nतथागतों और सद्धर्म,\nविमल रत्न तथा बुद्धपुत्रों,\nजो गुणों के सागर हैं, की मैं भली-भाँति पूजा करता हूँ।"
   },
   {
    "id": "2-23",
    "bo": "ཡོན་ཏན་རྒྱ་མཚོ་རྣམས་ལ་བདག ། བསྟོད་དབྱངས་ཡན་ལག་རྒྱ་མཚོས་བསྟོད། ། བསྟོད་དབྱངས་སྙན་སྤྲིན་དེ་དག་ལ། ། ངེས་པར་ཀུན་དུ་འབྱུང་གྱུར་ཅིག །",
    "gemini_zero_shot": "मैं उन गुण-सागरों की,\nस्तुतिगीतों के सागर से स्तुति करता हूँ।\nस्तुतिगीतों के वे मधुर मेघ,\nनिश्चित रूप से उन पर सर्वत्र छा जाएँ।"
   }
  ]
 },
