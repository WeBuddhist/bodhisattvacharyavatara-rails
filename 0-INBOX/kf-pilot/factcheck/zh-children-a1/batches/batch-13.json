  "tibetan": "འགྲོ་གང་ང་རྒྱལ་གྱིས་བཅོམ་དེ། ། ཉོན་མོངས་ང་རྒྱལ་ཅན་མ་ཡིན། ། ང་རྒྱལ་ཅན་དགྲའི་དབང་མི་འགྲོ། ། དེ་དག་ང་རྒྱལ་དགྲ་དབང་འགྱུར། །",
  "academic_translation": "任何被慢摧毀之眾生，\n皆具煩惱而非具慢者。\n具慢者不落入敵手，\n彼等則落入慢敵之手。",
  "locked_terms": [
