 },
 {
  "id": "7-52",
  "tibetan": "ཤི་བའི་སྦྲུལ་དང་ཕྲད་གྱུར་ན། ། ཁྭ་ཡང་མཁའ་ལྡིང་ལྟ་བུར་སྤྱོད། ། གལ་ཏེ་བདག་ཉིད་ཉམ་ཆུང་ན། ། ལྟུང་བ་ཆུང་ངུའང་གནོད་པར་བྱེད། །",
  "academic_translation": "若遇死去之蛇屍，\n烏鴉亦如金翅鳥；\n倘若我自身懦弱，\n微小墮罪亦為害。",
  "locked_terms": [
   {
    "tibetan": "མཁའ་ལྡིང",
