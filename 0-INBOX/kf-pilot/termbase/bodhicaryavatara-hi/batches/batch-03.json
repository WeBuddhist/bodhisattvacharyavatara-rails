  "examples": [
   {
    "id": "4-25",
    "bo": "དམྱལ་མེ་བཟོད་དཀས་དུས་རིང་དུ། ། བདག་གི་ལུས་ལ་བསྲེགས་གྱུར་ན། ། འགྱོད་པ་མི་བཟད་མེ་འབར་བས། ། སེམས་གདུང་འགྱུར་བ་གདོན་མི་ཟ། །",
    "gemini_zero_shot": "नरक की दुःसह अग्नि से दीर्घकाल तक,\nयदि मेरा शरीर जलाया गया,\nतो दुःसह पश्चात्ताप की अग्नि प्रज्वलित होने से,\nमन सन्तप्त होगा, इसमें कोई सन्देह नहीं।"
   },
   {
    "id": "5-23",
    "bo": "སེམས་བསྲུང་འདོད་པ་རྣམས་ལ་ནི། ། དྲན་པ་དང་ནི་ཤེས་བཞིན་དག ། ཐམས་ཅད་འབད་པས་སྲུངས་ཤིག་ཅེས། ། བདག་ནི་དེ་ལྟར་ཐལ་མོ་སྦྱོར། །",
    "gemini_zero_shot": "चित्त की रक्षा की इच्छा रखने वालों से,\nस्मृति और सम्प्रजन्य की,\nपूर्ण प्रयत्न से रक्षा करो, यह कहते हुए,\nमैं इस प्रकार हाथ जोड़ता हूँ।"
   },
   {
    "id": "5-25",
    "bo": "ཤེས་བཞིན་མེད་པའི་སེམས་ལྡན་པའི། ། ཐོས་དང་བསམས་དང་བསྒོམས་པ་ཡང་། ། གློ་རྡོལ་བུམ་པའི་ཆུ་བཞིན་དུ། ། དྲན་པ་ལ་ནི་དེ་མི་གནས། །",
    "gemini_zero_shot": "सम्प्रजन्य-रहित चित्त वालों के,\nश्रवण, मनन और भावना भी,\nछिद्रयुक्त घड़े के जल की भाँति,\nस्मृति में नहीं टिक पाते हैं।"
   }
  ]
 },
