   }
  ],
  "examples": [
   {
    "id": "2-13",
    "bo": "གོས་བཟང་སྲབ་ལ་འཇམ་པ་སྣ་ཚོགས་དང་། ། རྒྱན་མཆོག་བརྒྱ་ཕྲག་དེ་དང་དེ་དག་གིས། ། འཕགས་པ་ཀུན་ཏུ་བཟང་དང་འཇམ་དབྱངས་དང་། ། འཇིག་རྟེན་དབང་ཕྱུག་སོགས་ལའང་བརྒྱན་པར་བགྱི། །",
    "gemini_zero_shot": "विभिन्न प्रकार के महीन और कोमल उत्तम वस्त्रों,\nतथा उन सैकड़ों उत्तम आभूषणों से,\nआर्य समन्तभद्र, मञ्जुश्री और\nअवलोकितेश्वर आदि को भी अलंकृत करता हूँ।"
   },
   {
    "id": "2-22",
    "bo": "ཇི་ལྟར་འཇམ་དབྱངས་ལ་སོགས་པས། ། རྒྱལ་བ་རྣམས་ལ་མཆོད་མཛད་པ། ། དེ་བཞིན་བདག་གིས་དེ་བཞིན་གཤེགས། ། མགོན་པོ་སྲས་དང་བཅས་རྣམས་མཆོད། །",
    "gemini_zero_shot": "जिस प्रकार मञ्जुघोष आदि ने,\nजिनों की पूजा की है,\nउसी प्रकार मैं भी तथागतों,\nऔर सपुत्र नाथों की पूजा करता हूँ।"
   },
