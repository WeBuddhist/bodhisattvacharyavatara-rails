   {
    "id": "9-31",
    "bo": "དེ་བྱེད་པ་ནི་ཤེས་བྱ་ལ། ། ཉོན་མོངས་བག་ཆགས་མ་སྤངས་པ། ། དེས་ན་དེ་མཐོང་བ་ན་དེ། ། སྟོང་ཉིད་བག་ཆགས་ཉམ་ཆུང་ཉིད། །",
    "gemini_zero_shot": "उस निर्माता ने ज्ञेय के प्रति,\nक्लेशों की वासना का प्रहाण नहीं किया है।\nइसलिए उसे देखते समय उसकी,\nशून्यता की वासना दुर्बल ही होती है।"
   },
   {
    "id": "9-60",
    "bo": "གལ་ཏེ་སྒྲ་ཡི་ཤེས་རྟག་ན། ། ཐམས་ཅད་ཚེ་ན་སྒྲ་འཛིན་འགྱུར། ། ཤེས་བྱ་མེད་ན་ཅི་ཞིག་རིག ། གང་གིས་ཤེས་པ་ཞེས་རྗོད་བྱེད། །",
    "gemini_zero_shot": "यदि शब्द का ज्ञान नित्य है,\nतो सर्वदा शब्द का ग्रहण होगा।\nयदि ज्ञेय नहीं है, तो क्या जानेगा,\nजिसके द्वारा उसे ज्ञान कहा जाए?"
   },
   {
    "id": "9-121",
    "bo": "དེས་བསྐྱེད་འདོད་པའང་གང་ཞིག་ཡིན། ། བདག་ནི་དེ་དང་ས་སོགས་དང་། ། དབང་ཕྱུག་ངོ་བོའང་རྟག་མིན་ནམ། ། ཤེས་པ་ཤེས་བྱ་ལས་སྐྱེ་དང་། །",
    "gemini_zero_shot": "उसके द्वारा उत्पन्न अभीष्ट क्या है?\nआत्मा, वह और पृथ्वी आदि,\nतथा ईश्वर का स्वभाव क्या नित्य नहीं है?\nऔर ज्ञान ज्ञेय से उत्पन्न होता है।"
   }
  ]
