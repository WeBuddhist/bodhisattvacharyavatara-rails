 },
 {
  "id": "7-53",
  "tibetan": "ཞུམ་བཅས་རྩོལ་བ་དོར་བ་ལ། ། ཕོངས་ལས་ཐར་བ་ཡོད་དམ་ཅི། ། ང་རྒྱལ་རྩོལ་བ་བསྐྱེད་པས་ནི། ། ཆེན་པོ་ཡིས་ཀྱང་ཐུབ་པར་དཀའ། །",
  "academic_translation": "懷怯弱而捨棄勤勉，\n豈能從匱乏中解脫？\n藉由生起慢與勤勉，\n巨大墮罪亦難敗我。",
  "locked_terms": [
