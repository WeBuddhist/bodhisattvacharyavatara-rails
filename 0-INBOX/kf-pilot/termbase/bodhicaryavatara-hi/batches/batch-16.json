  "examples": [
   {
    "id": "2-1",
    "bo": "རིན་ཆེན་སེམས་དེ་གཟུང་བར་བྱ་བའི་ཕྱིར། ། དེ་བཞིན་གཤེགས་པ་རྣམས་དང་དམ་པའི་ཆོས། ། དཀོན་མཆོག་དྲི་མ་མེད་དང་སངས་རྒྱས་སྲས། ། ཡོན་ཏན་རྒྱ་མཚོ་རྣམས་ལ་ལེགས་པར་མཆོད། །",
    "gemini_zero_shot": "उस रत्न-तुल्य चित्त को ग्रहण करने के लिए,\nतथागतों और सद्धर्म,\nविमल रत्न तथा बुद्धपुत्रों,\nजो गुणों के सागर हैं, की मैं भली-भाँति पूजा करता हूँ।"
   },
   {
    "id": "5-86",
    "bo": "དམ་པའི་ཆོས་ནི་སྤྱོད་པའི་ལུས། ། ཕྲན་ཚེགས་ཆེད་དུ་གནོད་མི་བྱ། ། དེ་ལྟར་བྱས་ན་སེམས་ཅན་གྱི། ། བསམ་པ་མྱུར་དུ་རྫོགས་པར་འགྱུར། །",
    "gemini_zero_shot": "सद्धर्म का आचरण करने वाले इस शरीर को,\nतुच्छ कार्यों के लिए हानि नहीं पहुँचानी चाहिए।\nऐसा करने पर सत्त्वों की,\nमनोकामनाएँ शीघ्र पूर्ण होंगी।"
   },
   {
    "id": "6-109",
    "bo": "གལ་ཏེ་བཟོད་བསྒྲུབ་བསམ་མེད་པས། ། དགྲ་འདི་མཆོད་བྱ་མིན་ཞེ་ན། ། གྲུབ་པ་ཡི་ནི་རྒྱུར་རུང་བ། ། དམ་པའི་ཆོས་ཀྱང་ཅི་སྟེ་མཆོད། །",
    "gemini_zero_shot": "यदि कहें कि 'क्षान्ति सिद्ध करने की मंशा न होने के कारण,\nयह शत्रु पूजनीय नहीं है', तो\nसिद्धि का योग्य कारण होने पर भी,\nसद्धर्म की पूजा क्यों करते हो?"
   }
  ]
 },
