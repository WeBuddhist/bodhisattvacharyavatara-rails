 },
 {
  "id": "9-69",
  "tibetan": "ཇི་སྟེ་བདག་ལ་འགྱུར་མེད་ན། ། སེམས་པས་དེ་ལ་ཅི་ཞིག་བྱས། ། དེ་ལྟར་ཤེས་མེད་བྱ་བྲལ་བ། ། ནམ་མཁའ་བདག་ཏུ་བྱས་པར་འགྱུར། །",
  "academic_translation": "若我無變化，\n心於彼有何作為？\n如是無知無作為，\n虛空將成我。",
  "locked_terms": [
   {
    "tibetan": "བདག",
    "use": "自己"
