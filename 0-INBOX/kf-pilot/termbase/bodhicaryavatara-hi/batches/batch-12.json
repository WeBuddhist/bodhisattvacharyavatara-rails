  "examples": [
   {
    "id": "1-34",
    "bo": "གང་ཞིག་དེ་འདྲའི་རྒྱལ་སྲས་སྦྱིན་བདག་ལ། ། གལ་ཏེ་ངན་སེམས་སྐྱེད་པར་བྱེད་ན་དེ། ། ངན་སེམས་བསྐྱེད་པའི་གྲངས་བཞིན་བསྐལ་པར་ནི། ། དམྱལ་བར་གནས་པར་འགྱུར་ཞེས་ཐུབ་པས་གསུངས། །",
    "gemini_zero_shot": "जो कोई ऐसे जिनपुत्र दानापति के प्रति,\nयदि दुर्भावना उत्पन्न करता है, तो वह\nदुर्भावना उत्पन्न करने की संख्या के बराबर कल्पों तक,\nनरक में निवास करेगा, ऐसा मुनि ने कहा है।"
   },
   {
    "id": "2-6",
    "bo": "བློ་ཡིས་བླངས་ནས་ཐུབ་པ་སྐྱེས་ཀྱི་མཆོག ། སྲས་དང་བཅས་པ་རྣམས་ལ་ལེགས་འབུལ་ན། ། ཡོན་གནས་དམ་པ་ཐུགས་རྗེ་ཆེ་རྣམས་ཀྱིས། ། བདག་ལ་བརྩེར་དགོངས་བདག་གི་འདི་དག་བཞེས། །",
    "gemini_zero_shot": "उन्हें मन से ग्रहण करके, मैं मुनिश्रेष्ठों,\nऔर उनके पुत्रों को भली-भाँति अर्पित करता हूँ;\nवे परम दक्षिणीय, महाकरुणामय,\nमुझ पर कृपा करके मेरे इन्हें स्वीकार करें।"
   },
   {
    "id": "5-8",
    "bo": "དེ་འདྲ་དེ་དག་ཐམས་ཅད་ཀྱང་། ། སྡིག་སེམས་ཡིན་པར་ཐུབ་པས་གསུངས། ། དེ་ལྟར་འཇིག་རྟེན་གསུམ་པོ་ན། ། སེམས་ལས་འཇིགས་པ་གཞན་འགའ་མེད། །",
    "gemini_zero_shot": "वे सभी इस प्रकार की वस्तुएँ भी,\nपापमय चित्त से ही उत्पन्न हैं, ऐसा मुनि ने कहा है।\nइस प्रकार, तीनों लोकों में,\nचित्त के अतिरिक्त अन्य कोई भय नहीं है।"
   }
  ]
 },
