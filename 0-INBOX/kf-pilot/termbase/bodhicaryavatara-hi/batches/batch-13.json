  "examples": [
   {
    "id": "1-5",
    "bo": "ཇི་ལྟར་མཚན་མོ་མུན་ནག་སྤྲིན་རུམ་ན། ། གློག་འགྱུ་སྐད་ཅིག་རབ་སྣང་སྟོན་པ་ལྟར། ། དེ་བཞིན་སངས་རྒྱས་མཐུ་ཡིས་བརྒྱ་ལམ་ན། ། འཇིག་རྟེན་བསོད་ནམས་བློ་གྲོས་ཐང་འགའ་འབྱུང་། །",
    "gemini_zero_shot": "जैसे घोर अंधकारमयी रात में बादलों के बीच\nक्षण भर चमकने वाली बिजली तीव्र प्रकाश दिखाती है,\nउसी प्रकार, बुद्ध के प्रभाव से कभी-कभार ही\nलोक की बुद्धि क्षण भर के लिए पुण्यों की ओर प्रवृत्त होती है।"
   },
   {
    "id": "1-9",
    "bo": "བྱང་ཆུབ་སེམས་སྐྱེས་གྱུར་ན་སྐད་ཅིག་གིས། ། འཁོར་བའི་བཙོན་རར་བསྡམས་པའི་ཉམ་ཐག་རྣམས། ། བདེ་གཤེགས་རྣམས་ཀྱི་སྲས་ཞེས་བརྗོད་བྱ་ཞིང་། ། འཇིག་རྟེན་ལྷ་མིར་བཅས་པས་ཕྱག་བྱར་འགྱུར། །",
    "gemini_zero_shot": "बोधिचित्त उत्पन्न होते ही क्षण भर में,\nसंसार के कारागार में बंधे हुए दीन प्राणी,\nसुगतों के पुत्र कहलाते हैं,\nऔर देवों तथा मनुष्यों सहित लोक के वंदनीय हो जाते हैं।"
   },
   {
    "id": "5-93",
    "bo": "བཞོན་པ་མལ་སྟན་གནས་དག་ཏུ། ། བུད་མེད་གཞན་དང་གཅིག་མི་བྱ། ། འཇིག་རྟེན་མ་དད་གྱུར་པ་ཀུན། ། མཐོང་དང་དྲིས་ཏེ་སྤང་བར་བྱ། །",
    "gemini_zero_shot": "सवारी, शय्या और आसन पर,\nपराई स्त्री के साथ अकेले न बैठे।\nजिन सबसे लोक में अश्रद्धा उत्पन्न हो,\nदेखकर और पूछकर उनका परित्याग करे।"
   }
  ]
 },
