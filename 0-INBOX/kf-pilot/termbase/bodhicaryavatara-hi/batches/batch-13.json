  "examples": [
   {
    "id": "5-14",
    "bo": "དེ་བཞིན་ཕྱི་རོལ་དངོས་པོ་ཡང་། ། བདག་གིས་ཕྱིར་བཟློག་མི་ལང་གི ། བདག་གི་སེམས་འདི་ཕྱིར་བཟློག་བྱའི། ། གཞན་རྣམས་བཟློག་གོ་ཅི་ཞིག་དགོས། །",
    "gemini_zero_shot": "उसी प्रकार बाह्य वस्तुओं का भी,\nमैं निवारण करने में समर्थ नहीं हूँ,\nअतः अपने इस चित्त का ही निवारण करूँगा,\nअन्यों का निवारण करने की क्या आवश्यकता है?"
   },
   {
    "id": "6-31",
    "bo": "དེ་ལྟར་ཐམས་ཅད་གཞན་གྱི་དབང་། ། དེ་ཡི་དབང་གིས་དེ་དབང་མེད། ། དེ་ལྟར་ཤེས་ན་སྦྲུལ་ལྟ་བུའི། ། དངོས་པོ་ཀུན་ལ་ཁྲོ་མི་འགྱུར། །",
    "gemini_zero_shot": "इस प्रकार सब कुछ परतन्त्र है,\nजिसके वे अधीन हैं, वह भी स्वतन्त्र नहीं है,\nऐसा जानकर माया-निर्मित के समान,\nसभी भावों पर क्रोध नहीं करना चाहिए।"
   },
   {
    "id": "9-26",
    "bo": "སེམས་ལས་སྒྱུ་མ་གཞན་མིན་ཞིང་། ། གཞན་མིན་པར་ཡང་མི་རྟག་ན། ། དངོས་ན་ཇི་ལྟར་དེ་གཞན་མིན། ། གཞན་མིན་ཞེ་ན་དངོས་པོར་མེད། །",
    "gemini_zero_shot": "माया चित्त से अन्य नहीं है,\nऔर अनन्य भी कल्पित नहीं की जाती।\nयदि वह वस्तु है, तो अनन्य कैसे?\nयदि अनन्य है, तो वस्तु रूप में नहीं है।"
   }
  ]
 },
