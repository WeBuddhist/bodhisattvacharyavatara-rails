  "examples": [
   {
    "id": "1-3",
    "bo": "དགེ་བ་བསྒོམ་ཕྱིར་བདག་གི་དད་པའི་ཤུགས། ། འདི་དག་གིས་ཀྱང་རེ་ཞིག་འཕེལ་འགྱུར་ལ། ། བདག་དང་སྐལ་བ་མཉམ་པ་གཞན་གྱིས་ཀྱང་། ། ཅི་སྟེ་འདི་དག་མཐོང་ན་དོན་ཡོད་འགྱུར། །",
    "gemini_zero_shot": "कुशल की भावना करने से मेरी श्रद्धा का बल\nइनके माध्यम से कुछ समय के लिए बढ़ेगा,\nऔर यदि मेरे ही समान भाग्य वाले अन्य लोगों द्वारा\nइन्हें देखा जाए, तो यह सार्थक होगा।"
   },
   {
    "id": "1-12",
    "bo": "དགེ་བ་གཞན་ཀུན་ཆུ་ཤིང་བཞིན་དུ་ནི། ། འབྲས་བུ་བསྐྱེད་ནས་ཟད་པར་འགྱུར་བ་ཉིད། ། བྱང་ཆུབ་སེམས་ཀྱི་ལྗོན་ཤིང་རྟག་པར་ཡང་། ། འབྲས་བུ་འབྱིན་པས་མི་ཟད་འཕེལ་བར་འགྱུར། །",
    "gemini_zero_shot": "अन्य सभी कुशल कर्म कदली-वृक्ष की भाँति,\nफल उत्पन्न करने के पश्चात् नष्ट हो जाते हैं।\nपरन्तु बोधिचित्त का वृक्ष सदैव\nफल देता है और नष्ट हुए बिना बढ़ता ही जाता है।"
   },
   {
    "id": "4-19",
    "bo": "དགེ་བ་དག་ཀྱང་མ་བྱས་ལ། ། སྡིག་པ་དག་ཀྱང་ཉེར་བསགས་ན། ། བསྐལ་པ་བྱེ་བ་བརྒྱར་ཡང་ནི། ། བདེ་འགྲོའི་སྒྲ་ཡང་ཐོས་མི་འགྱུར། །",
    "gemini_zero_shot": "यदि कुशल भी नहीं किया,\nऔर पापों का ही संचय किया,\nतो सौ करोड़ कल्पों तक भी,\nसुगति का शब्द भी सुनाई नहीं देगा।"
   }
  ]
 },
