 },
 {
  "id": "7-66",
  "tibetan": "སྟོབས་ཉམས་པ་དང་རྗེས་འབྲེལ་ན། ། སླར་བྱའི་དོན་དུ་དོར་བར་བྱ། ། ལེགས་པར་ཟིན་ན་ཕྱི་མ་དང་། ། ཕྱི་མ་འདོད་པས་དེ་སྤང་བྱ། །",
  "academic_translation": "若與力量衰退相伴隨，\n為求復作應將其暫捨；\n若已善成，因欲求其後\n與更後之事業而捨前。",
  "locked_terms": [],
  "translation": "如果我的力氣變小了，為了之後能繼續做，我應該先停下來休息。如果一件事已經好好完成了，為了去做接下來的事，我就該放下它。"
 },
 {
