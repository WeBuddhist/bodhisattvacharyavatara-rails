 },
 {
  "id": "7-59",
  "tibetan": "གང་ཞིག་ང་རྒྱལ་དགྲ་ལས་རྒྱལ་ཕྱིར་ང་རྒྱལ་འཆང་། ། དེ་ནི་ང་རྒྱལ་ཅན་དང་རྣམ་རྒྱལ་དཔའ་དེ་ཉིད། ། གང་ཞིག་ང་རྒྱལ་དགྲ་བདོ་བ་ཡང་ངེས་བཅོམ་སྟེ། ། འགྲོ་ལ་འདོད་བཞིན་རྒྱལ་བའི་འབྲས་བུ་རྫོགས་པར་བྱེད། །",
  "academic_translation": "任何為勝慢敵而懷抱慢者，\n彼即具慢者與得勝勇士。\n任何確實摧毀猖獗慢敵者，\n便如願為眾生圓滿勝果。",
  "locked_terms": [
