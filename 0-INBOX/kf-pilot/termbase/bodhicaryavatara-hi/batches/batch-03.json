  "examples": [
   {
    "id": "2-24",
    "bo": "དུས་གསུམ་གཤེགས་པའི་སངས་རྒྱས་ཀུན། ། ཆོས་དང་ཚོགས་ཀྱི་མཆོག་བཅས་ལ། ། ཞིང་རྡུལ་ཀུན་གྱི་གྲངས་སྙེད་ཀྱི། ། ལུས་བཏུད་པ་ཡིས་བདག་ཕྱག་འཚལ། །",
    "gemini_zero_shot": "तीनों कालों में पधारे सभी बुद्धों,\nधर्म और उत्तम संघ को,\nसभी बुद्ध-क्षेत्रों के परमाणुओं की संख्या के बराबर,\nशरीर झुकाकर मैं वन्दना करता हूँ।"
   },
   {
    "id": "5-89",
    "bo": "དམན་ལ་ཟབ་དང་རྒྱ་ཆེ་དང་། ། སྐྱེས་པ་མེད་པར་བུད་མེད་མིན། ། དམན་དང་མཆོག་གི་ཆོས་རྣམས་ལ། ། མཚུངས་པར་གུས་པས་ཀུན་དུ་སྤྱད། །",
    "gemini_zero_shot": "हीन बुद्धि वाले को गम्भीर और विस्तीर्ण धर्म का,\nतथा पुरुष के बिना स्त्री को उपदेश न दे।\nहीन और श्रेष्ठ धर्मों के प्रति,\nसमान रूप से आदरपूर्वक आचरण करे।"
   },
   {
    "id": "9-105",
    "bo": "འོན་ཏེ་ཤེས་བྱའི་ཕྱིས་ཡོད་ན། ། དེ་ཚེ་ཤེས་པ་གང་ལས་སྐྱེ། ། དེ་ལྟར་ཆོས་རྣམས་ཐམས་ཅད་ཀྱི། ། སྐྱེ་བ་རྟོགས་པར་འགྱུར་མ་ཡིན། །",
    "gemini_zero_shot": "अथवा यदि ज्ञेय के पश्चात् ज्ञान है,\nतो उस समय ज्ञान किससे उत्पन्न होता है?\nइस प्रकार सभी धर्मों की,\nउत्पत्ति ज्ञात नहीं होती।"
   }
  ]
 },
