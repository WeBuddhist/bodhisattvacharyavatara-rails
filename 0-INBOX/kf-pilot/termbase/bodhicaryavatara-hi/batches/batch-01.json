  "examples": [
   {
    "id": "6-57",
    "bo": "རྨི་ལམ་ལོ་བརྒྱར་བདེ་མྱོང་ནས། ། སད་པར་གྱུར་པ་གང་ཡིན་དང་། ། གཞན་ཞིག་ཡུད་ཙམ་བདེ་མྱོང་ནས། ། སད་པར་གྱུར་པ་གང་ཡིན་པ། །",
    "gemini_zero_shot": "सौ वर्षों तक स्वप्न में सुख भोगने के पश्चात्,\nजो कोई जाग जाता है, और\nअन्य कोई क्षण मात्र सुख भोगने के पश्चात्,\nजो कोई जाग जाता है;"
   },
   {
    "id": "8-156",
    "bo": "གལ་ཏེ་ཁྱོད་ཀྱིས་སྔ་དུས་སུ། ། ལས་འདི་བྱས་པར་གྱུར་ན་ནི། ། སངས་རྒྱས་ཕུན་སུམ་བདེ་མིན་པ། ། གནས་སྐབས་འདི་འདྲར་འགྱུར་མི་སྲིད། །",
    "gemini_zero_shot": "यदि तुमने पूर्व काल में,\nयह कर्म किया होता,\nतो बुद्ध के पूर्ण सुख से रहित,\nऐसी अवस्था कभी सम्भव न होती।"
   },
   {
    "id": "9-129",
    "bo": "ཡོན་ཏན་མེད་ན་སྒྲ་སོགས་ཀྱང་། ། ཡོད་ཉིད་ཤིན་ཏུ་རྒྱང་རིང་འགྱུར། ། སེམས་མེད་གོས་ལ་སོགས་པ་ལ། ། བདེ་སོགས་ཡོད་པ་སྲིད་པའང་མིན། །",
    "gemini_zero_shot": "गुणों के अभाव में शब्द आदि का\nअस्तित्व भी अत्यन्त दूर हो जाएगा।\nअचेतन वस्त्र आदि में\nसुख आदि का होना सम्भव भी नहीं है।"
   }
  ]
