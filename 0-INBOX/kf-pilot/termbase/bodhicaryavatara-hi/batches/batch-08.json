  "examples": [
   {
    "id": "1-12",
    "bo": "དགེ་བ་གཞན་ཀུན་ཆུ་ཤིང་བཞིན་དུ་ནི། ། འབྲས་བུ་བསྐྱེད་ནས་ཟད་པར་འགྱུར་བ་ཉིད། ། བྱང་ཆུབ་སེམས་ཀྱི་ལྗོན་ཤིང་རྟག་པར་ཡང་། ། འབྲས་བུ་འབྱིན་པས་མི་ཟད་འཕེལ་བར་འགྱུར། །",
    "gemini_zero_shot": "अन्य सभी कुशल कर्म कदली-वृक्ष की भाँति,\nफल उत्पन्न करने के पश्चात् नष्ट हो जाते हैं।\nपरन्तु बोधिचित्त का वृक्ष सदैव\nफल देता है और नष्ट हुए बिना बढ़ता ही जाता है।"
   },
   {
    "id": "1-17",
    "bo": "བྱང་ཆུབ་སྨོན་པའི་སེམས་ལས་ནི། ། འཁོར་ཚེ་འབྲས་བུ་ཆེ་འབྱུང་ཡང་། ། ཇི་ལྟར་འཇུག་པའི་སེམས་བཞིན་དུ། ། བསོད་ནམས་རྒྱུན་ཆགས་འབྱུང་བ་མིན། །",
    "gemini_zero_shot": "बोधि-प्रणिधान-चित्त से,\nसंसार में महान फल उत्पन्न होने पर भी,\nप्रस्थान-चित्त के समान,\nनिरन्तर पुण्य उत्पन्न नहीं होता।"
   },
   {
    "id": "5-15",
    "bo": "སེམས་གསལ་གཅིག་བསྐྱེད་འབྲས་བུ་གང་། ། ཚངས་ལ་སོགས་པ་ཡིན་པ་ལྟར། ། ལུས་ངག་བཅས་པའི་འབྲས་བུ་ཡང་། ། སྤྱོད་པ་ཞན་པས་དེ་ལྟ་མིན། །",
    "gemini_zero_shot": "एक निर्मल चित्त उत्पन्न करने का जो फल है,\nवह ब्रह्मा आदि का जन्म होने के समान है,\nकिन्तु शरीर और वाणी से युक्त कर्मों का फल भी,\nआचरण मन्द होने के कारण वैसा नहीं होता।"
   }
  ]
 },
