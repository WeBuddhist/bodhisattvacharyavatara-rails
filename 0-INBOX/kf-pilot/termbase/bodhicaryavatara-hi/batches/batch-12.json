  "examples": [
   {
    "id": "1-0",
    "bo": "ལེའུ་དང་པོ། བྱང་ཆུབ་སེམས་ཀྱི་ཕན་ཡོན་བཤད་པ།",
    "gemini_zero_shot": "प्रथम परिच्छेद: बोधिचित्तानुशंसा"
   },
   {
    "id": "1-6",
    "bo": "དེ་ལྟས་དགེ་བ་ཉམ་ཆུང་ཉིད་ལ་བརྟག ། སྡིག་པ་སྟོབས་ཆེན་ཤིན་ཏུ་མི་བཟད་པ། ། དེ་ནི་རྫོགས་པའི་བྱང་ཆུབ་སེམས་མིན་པ། ། དགེ་གཞན་གང་གིས་ཟིལ་གྱིས་གནོན་པར་འགྱུར། །",
    "gemini_zero_shot": "इस प्रकार, कुशल कर्म अत्यंत दुर्बल होते हैं,\nजबकि पाप अत्यंत भयानक और शक्तिशाली होते हैं।\nउस पूर्ण बोधिचित्त के अतिरिक्त,\nअन्य कौन सा कुशल कर्म उन्हें पराजित कर सकता है?"
   },
   {
    "id": "1-8",
    "bo": "སྲིད་པའི་སྡུག་བསྔལ་བརྒྱ་ཕྲག་གཞོམ་འདོད་ཅིང་། ། སེམས་ཅན་མི་བདེ་བསལ་བར་འདོད་པ་དང་། ། བདེ་མང་བརྒྱ་ཕྲག་སྤྱོད་པར་འདོད་པས་ཀྱང་། ། བྱང་ཆུབ་སེམས་ཉིད་རྟག་ཏུ་གཏང་མི་བྱ། །",
    "gemini_zero_shot": "जो भव के सैकड़ों दुःखों का नाश करना चाहते हैं,\nसत्त्वों की पीड़ा को दूर करना चाहते हैं,\nऔर सैकड़ों सुखों का भोग करना चाहते हैं,\nउन्हें बोधिचित्त का कभी त्याग नहीं करना चाहिए।"
   }
  ]
 },
