     "text": "དཔེ༷ར་ན་༷་འག༷འ་ཞི༷ག་བསི༷ལ་བའི་རེག་བྱ་འདོད་པས་ཡ༷ང་ཡ༷ང་ཁྲུས༷་བྱས༷་ཏེ་གྲང་བས་ཉེན་པ་ན་སླར་ཚ་བ་འདོད་པས་ཡང༷་ཡ༷ང་མེ༷ར་འཇུག༷་པ༷་སྟེ་དེར་ཚ་བས་ཉེན་པ་ན་ཡང་ཁྲུས་ལ་འཇུག་པ་སྟེ། དེ༷་ལྟར༷་ཚ་གྲང་རེས་མོས་ཀྱི་སྒོ་ནས་ཤི༷ན་ཏུ་སྡུག༷་བསྔལ༷་བར༷་གན༷ས་ཀྱང༷་སྲེད་པས་རྨོངས་ནས་བད༷ག་ཉིད༷་བདེ༷ར་ཏེ་བདེ་བ་ཕུན་སུམ་ཚོགས་པ་དང་ལྡན་པར་རློམ་པ༷་བཞིན་ནོ། །"
    }
   ],
   "bo-shenga": [
    {
     "id": "9-164",
     "text": "དཔེར་ན་སྐྱེ་བོ་མྱོས་པ་འགའ་ཞིག་ཡང་ཡང་དུ་ཆུར་ཞུགས་ནས་ཁྲུས་བྱས་ཏེ་ཡང་ཡང་མེར་འཇུག་པ། ། དེ་ལྟར་ཤིན་ཏུ་སྡུག་བསྔལ་བར། ། གནས་ཀྱང་ད་དུང་བདག་ཉིད་བདེ་བར་རློམ་པ་བཞིན་ནོ། །"
    }
   ],
   "bo-gyaltsab": [
    {
     "id": "9-164",
     "text": "དཔེར་ན་འགའ་ཞིག་ཡང་ཡང་ཁྲུས། ། བྱས་ཏེ་ཡང་ཡང་མེར་འཇུག་པ། ། དེ་ལྟར་ཤིན་ཏུ་སྡུག་བསྔལ་བར། ། གནས་ཀྱང་བདག་ཉིད་བདེར་རློམ་བཞིན། །"
