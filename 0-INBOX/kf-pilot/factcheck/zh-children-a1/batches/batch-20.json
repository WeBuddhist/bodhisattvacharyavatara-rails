 },
 {
  "id": "9-67",
  "tibetan": "སེམས་པ་སེམས་མེད་དེ་དག་ཀྱང་། ། གཅིག་འགྱུར་གང་ཕྱིར་ཡོད་ཉིད་མཚུངས། ། གང་ཚེ་བྱེ་བྲག་ཕྱིན་ཅི་ལོག ། དེ་ཚེ་འདྲ་བའི་རྟེན་གང་ཡིན། །",
  "academic_translation": "有心者與無心者，\n也會成為一，因為同樣是存在。\n當各種差別都是顛倒時，\n那時相似的基礎是什麼？",
  "locked_terms": [],
  "translation": "照這個說法，有心智的生命和沒有心智的物品也都會變成同一個，因為它們同樣都存在。如果所有的不同都被說成是錯誤的，那我們到底要拿什麼當作相似的基礎呢？"
 },
 {
  "id": "9-68",
  "tibetan": "སེམས་མེད་པ་ཡང་བདག་མིན་ཏེ། ། སེམས་མེད་ཉིད་ཕྱིར་བུམ་སོགས་བཞིན། ། འོན་ཏེ་སེམས་དང་ལྡན་པའི་ཕྱིར། ། ཤེས་ན་མི་ཤེས་འཇིག་པར་ཐལ། །",
  "academic_translation": "無心者亦非我，\n無心故如瓶等。\n若謂因具心，\n而能知，無知應壞滅。",
  "locked_terms": [
