  "examples": [
   {
    "id": "5-29",
    "bo": "དེ་བས་དྲན་པ་ཡིད་སྒོ་ནས། ། གུད་དུ་ནམ་ཡང་མི་གཏོང་ངོ་། ། སོང་ནའང་ངན་འགྲོ་གནོད་པ་དག ། དྲན་པར་བྱས་ཏེ་ཉེ་བར་བཞག །",
    "gemini_zero_shot": "इसलिए स्मृति को मन के द्वार से,\nकभी भी दूर नहीं जाने देना चाहिए।\nयदि वह चली भी जाए, तो दुर्गति के कष्टों का,\nस्मरण करके उसे पुनः स्थापित करना चाहिए।"
   },
   {
    "id": "5-54",
    "bo": "དེ་ལྟར་ཀུན་ནས་ཉོན་མོངས་དང་། ། དོན་མེད་བརྩོན་པའི་ཡིད་བརྟགས་ནས། ། དེ་ཚེ་དཔའ་བོས་གཉེན་པོ་ཡིས། ། དེ་ནི་བརྟན་པོར་གཟུང་བར་བྱ། །",
    "gemini_zero_shot": "इस प्रकार क्लेशों से युक्त,\nऔर निरर्थक कार्यों में प्रवृत्त चित्त को जानकर,\nउस समय वीर (बोधिसत्त्व) प्रतिपक्ष के द्वारा,\nउसे दृढ़तापूर्वक वश में रखेगा।"
   },
   {
    "id": "9-27",
    "bo": "ཇི་ལྟར་སྒྱུ་མ་བདེན་མིན་ཡང་། ། བལྟ་བྱ་དེ་བཞིན་ལྟ་བྱེད་ཡིད། ། གལ་ཏེ་འཁོར་བ་དངོས་རྟེན་ཅན། ། དེ་ནི་གཞན་དུ་མཁའ་འདྲར་འགྱུར། །",
    "gemini_zero_shot": "जिस प्रकार माया सत्य नहीं होने पर भी,\nदृश्य है, उसी प्रकार मन दृष्टा है।\nयदि संसार वस्तु पर आश्रित है,\nअन्यथा वह आकाश के समान हो जाएगा।"
   }
  ]
 },
