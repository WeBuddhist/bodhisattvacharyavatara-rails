  "examples": [
   {
    "id": "6-43",
    "bo": "དེ་ཡི་མཚོན་དང་བདག་གི་ལུས། ། གཉི་ག་སྡུག་བསྔལ་རྒྱུ་ཡིན་ཏེ། ། དེས་མཚོན་བདག་གི་ལུས་ཕྱུང་ན། ། གང་ཞིག་ལ་ནི་ཁྲོ་བར་བྱ། །",
    "gemini_zero_shot": "उसका अस्त्र और मेरा शरीर,\nदोनों ही दुःख के कारण हैं।\nउसने अस्त्र और मैंने शरीर प्रस्तुत किया,\nतो किस पर क्रोध किया जाए?"
   },
   {
    "id": "6-104",
    "bo": "གང་ཞིག་གང་མེད་མི་འབྱུང་ལ། ། གང་ཞིག་ཡོད་ན་ཡོད་གྱུར་པ། ། དེ་ཉིད་དེ་ཡི་རྒྱུ་ཡིན་ན། ། ཇི་ལྟར་དེ་ལ་གེགས་ཞེས་བྱ། །",
    "gemini_zero_shot": "जिसके बिना जो उत्पन्न नहीं होता,\nऔर जिसके होने पर जो होता है,\nवही उसका कारण है,\nतो उसे विघ्न कैसे कहा जा सकता है?"
   },
   {
    "id": "9-117",
    "bo": "རྒྱུ་དབྱེ་གང་གིས་བྱས་ཞེ་ན། ། སྔར་གྱི་རྒྱུ་དབྱེ་ཉིད་ལས་སོ། ། ཅི་ཕྱིར་རྒྱུ་ཡིས་འབྲས་སྐྱེད་ནུས། ། སྔར་གྱི་རྒྱུ་ཡི་མཐུ་ཉིད་ལས། །",
    "gemini_zero_shot": "यदि पूछा जाए कि कारणों की विविधता किसने की?\nतो पूर्ववर्ती कारणों की विविधता से ही है।\nकारण कार्य उत्पन्न करने में समर्थ क्यों है?\nपूर्ववर्ती कारण की शक्ति से ही।"
   }
  ]
 },
