  ],
  "examples": [
   {
    "id": "1-9",
    "bo": "བྱང་ཆུབ་སེམས་སྐྱེས་གྱུར་ན་སྐད་ཅིག་གིས། ། འཁོར་བའི་བཙོན་རར་བསྡམས་པའི་ཉམ་ཐག་རྣམས། ། བདེ་གཤེགས་རྣམས་ཀྱི་སྲས་ཞེས་བརྗོད་བྱ་ཞིང་། ། འཇིག་རྟེན་ལྷ་མིར་བཅས་པས་ཕྱག་བྱར་འགྱུར། །",
    "gemini_zero_shot": "बोधिचित्त उत्पन्न होते ही क्षण भर में,\nसंसार के कारागार में बंधे हुए दीन प्राणी,\nसुगतों के पुत्र कहलाते हैं,\nऔर देवों तथा मनुष्यों सहित लोक के वंदनीय हो जाते हैं।"
   },
   {
    "id": "2-48",
    "bo": "དེ་ཡི་ཐུགས་སུ་ཆུད་པའི་ཆོས། ། འཁོར་བའི་འཇིགས་པ་སེལ་བ་དང་། ། བྱང་ཆུབ་སེམས་དཔའི་ཚོགས་ལ་ཡང་། ། དེ་བཞིན་ཡང་དག་སྐྱབས་སུ་མཆི། །",
    "gemini_zero_shot": "उनके द्वारा साक्षात्कृत धर्म की,\nजो संसार के भय को दूर करने वाला है,\nऔर बोधिसत्त्वों के संघ की भी,\nउसी प्रकार सम्यक् रूप से शरण में जाता हूँ।"
   },
   {
    "id": "3-2",
    "bo": "བྱང་ཆུབ་རྒྱུར་གྱུར་དགེ་བསགས་པ། ། དེ་ལ་རྗེས་སུ་ཡི་རང་ངོ་། ། ལུས་ཅན་འཁོར་བའི་སྡུག་བསྔལ་ལས། ། ངེས་པར་ཐར་ལ་ཡི་རང་ངོ་། ། སྐྱོབ་པ་རྣམས་ཀྱི་བྱང་ཆུབ་དང་། ། རྒྱལ་སྲས་ས་ལའང་ཡི་རང་ངོ་། །",
    "gemini_zero_shot": "बोधि के हेतु रूप में संचित पुण्यों का,\nमैं अनुमोदन करता हूँ।\nदेहधारियों के संसार के दुःखों से,\nनिश्चित मुक्ति का मैं अनुमोदन करता हूँ।\nरक्षकों की बोधि का और,\nबोधिसत्त्वों की भूमियों का भी मैं अनुमोदन करता हूँ।"
   }
  ]
 },
