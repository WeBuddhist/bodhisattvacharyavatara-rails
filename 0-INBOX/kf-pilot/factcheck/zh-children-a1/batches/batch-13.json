 },
 {
  "id": "7-62",
  "tibetan": "རྩེད་མོའི་བདེ་འབྲས་འདོད་པ་ལྟར། ། འདི་ཡིས་བྱ་བའི་ལས་གང་ཡིན། ། ལས་དེ་ལ་ནི་ཞེན་བྱ་སྟེ། ། ལས་དེས་མི་ངོམས་དགའ་བར་བྱ། །",
  "academic_translation": "猶如渴求遊戲之樂果，\n凡是此人應當作之業，\n對該事業應當生貪著，\n且無饜足於此生歡喜。",
  "locked_terms": [],
  "translation": "就像小孩渴望遊戲的快樂。我也該熱愛自己該做的好事。我要全心投入這些事，開心地去做，永遠不覺得滿足。"
 },
 {
  "id": "7-63",
  "tibetan": "བདེ་བའི་དོན་དུ་ལས་བྱས་ཀྱང་། ། བདེ་འགྱུར་མི་འགྱུར་གཏོལ་མེད་ཀྱི། ། གང་གི་ལས་ཉིད་བདེ་འགྱུར་བ། ། དེ་ལས་མི་བྱེད་ཇི་ལྟར་བདེ། །",
  "academic_translation": "雖為求樂而作業，\n生樂與否尚未知；\n若其作業即成樂，\n不作此業豈有樂？",
