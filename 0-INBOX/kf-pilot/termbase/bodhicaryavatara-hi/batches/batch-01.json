  "examples": [
   {
    "id": "1-8",
    "bo": "སྲིད་པའི་སྡུག་བསྔལ་བརྒྱ་ཕྲག་གཞོམ་འདོད་ཅིང་། ། སེམས་ཅན་མི་བདེ་བསལ་བར་འདོད་པ་དང་། ། བདེ་མང་བརྒྱ་ཕྲག་སྤྱོད་པར་འདོད་པས་ཀྱང་། ། བྱང་ཆུབ་སེམས་ཉིད་རྟག་ཏུ་གཏང་མི་བྱ། །",
    "gemini_zero_shot": "जो भव के सैकड़ों दुःखों का नाश करना चाहते हैं,\nसत्त्वों की पीड़ा को दूर करना चाहते हैं,\nऔर सैकड़ों सुखों का भोग करना चाहते हैं,\nउन्हें बोधिचित्त का कभी त्याग नहीं करना चाहिए।"
   },
   {
    "id": "1-26",
    "bo": "འགྲོ་བ་ཀུན་གྱི་དགའ་བའི་རྒྱུ། ། སེམས་ཅན་སྡུག་བསྔལ་རྩིར་གྱུར་པ། ། རིན་ཆེན་སེམས་ཀྱི་བསོད་ནམས་གང་། ། དེ་ལ་ཇི་ལྟར་གཞལ་གྱིས་ལང་། །",
    "gemini_zero_shot": "जो सम्पूर्ण जगत् के आनन्द का हेतु है,\nजो प्राणियों के दुःखों की औषधि है,\nउस रत्न-तुल्य चित्त के पुण्य को,\nभला कैसे मापा जा सकता है?"
   },
   {
    "id": "4-18",
    "bo": "གང་ཚེ་དགེ་སྤྱད་སྐལ་ལྡན་ཡང་། ། དགེ་བ་བདག་གིས་མ་བྱས་ན། ། ངན་སོང་སྡུག་བསྔལ་ཀུན་རྨོངས་པ། ། དེ་ཚེ་བདག་གིས་ཅི་བྱར་ཡོད། །",
    "gemini_zero_shot": "कुशल आचरण का अवसर होने पर भी,\nयदि मैंने कुशल नहीं किया,\nतो दुर्गति के दुखों से पूर्णतः मूढ़ होकर,\nउस समय मैं क्या कर सकूँगा?"
   }
  ]
 },
