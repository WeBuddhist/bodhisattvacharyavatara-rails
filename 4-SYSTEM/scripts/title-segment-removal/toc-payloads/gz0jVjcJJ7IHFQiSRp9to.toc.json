      "start": 0,
      "end": 123
     }
    },
    {
     "title": {
      "hi": "पहला अध्याय। बोधिचित्त के लाभों का वर्णन।"
     },
     "span": {
      "start": 123,
      "end": 5408
     }
    },
    {
     "title": {
      "hi": "दूसरा अध्याय। पाप की स्वीकारोक्ति।"
     },
     "span": {
      "start": 5408,
      "end": 13702
     }
    },
    {
     "title": {
      "hi": "तीसरा अध्याय। बोधिचित्त का पूर्ण स्वीकार।"
     },
     "span": {
      "start": 13702,
      "end": 17711
     }
    },
    {
     "title": {
      "hi": "चौथा अध्याय। सजगता की शिक्षा।"
     },
     "span": {
      "start": 17711,
      "end": 24398
     }
    },
    {
     "title": {
      "hi": "पांचवां अध्याय। सजगता की रक्षा।"
     },
     "span": {
      "start": 24398,
      "end": 37746
     }
    },
    {
     "title": {
      "hi": "छठा अध्याय। क्षमा की शिक्षा।"
     },
     "span": {
      "start": 37746,
      "end": 55675
     }
    },
    {
     "title": {
      "hi": "सातवां अध्याय। उत्साह की शिक्षा।"
     },
     "span": {
      "start": 55675,
      "end": 65726
     }
    },
    {
     "title": {
      "hi": "आठवां अध्याय। ध्यान की शिक्षा।"
     },
     "span": {
      "start": 65726,
      "end": 88685
     }
    },
    {
     "title": {
      "hi": "नौवां अध्याय। प्रज्ञा-पारमिता।"
     },
     "span": {
      "start": 88685,
      "end": 110427
     }
    },
    {
     "title": {
      "hi": "दसवां अध्याय। पुण्य-समर्पण।"
     },
     "span": {
      "start": 110427,
      "end": 117111
     }
    },
    {
     "title": {
      "hi": "लेखक की टिप्पणी।"
     },
     "span": {
      "start": 117111,
      "end": 117182
     }
    },
    {
     "title": {
      "hi": "अनुवादकों की टिप्पणी।"
     },
