  "examples": [
   {
    "id": "1-1",
    "bo": "བདེ་གཤེགས་ཆོས་ཀྱི་སྐུ་མངའ་སྲས་བཅས་དང་། ། ཕྱག་འོས་ཀུན་ལའང་གུས་པར་ཕྱག་འཚལ་ཏེ། ། བདེ་གཤེགས་སྲས་ཀྱི་སྡོམ་ལ་འཇུག་པ་ནི། ། ལུང་བཞིན་མདོར་བསྡུས་ནས་ནི་བརྗོད་པར་བྱ། །",
    "gemini_zero_shot": "धर्मकाय से युक्त सुगतों और उनके पुत्रों को,\nतथा वंदनीय सभी को श्रद्धापूर्वक नमस्कार करके,\nमैं सुगत-पुत्रों के संवर में प्रवेश करने का\nआगम के अनुसार संक्षेप में वर्णन करूँगा।"
   },
   {
    "id": "3-33",
    "bo": "བདག་གིས་དེ་རིང་སྐྱོབ་པ་ཐམས་ཅད་ཀྱི། ། སྤྱན་སྔར་འགྲོ་བ་བདེ་གཤེགས་ཉིད་དང་ནི། ། བར་དུ་བདེ་ལ་མགྲོན་དུ་བོས་ཟིན་གྱིས། ། ལྷ་དང་ལྷ་མིན་ལ་སོགས་དགའ་བར་གྱིས། །",
    "gemini_zero_shot": "आज मैंने समस्त रक्षकों के,\nसम्मुख प्राणियों को सुगत-पद और,\nबीच में सुख के लिए अतिथि रूप में आमन्त्रित किया है,\nइसलिए देव, असुर आदि आनन्दित हों।"
   },
   {
    "id": "7-44",
    "bo": "རྒྱ་ཆེ་དྲི་བཟང་བསེལ་བའི་པདྨའི་སྙིང་པོར་གནས། ། རྒྱལ་བའི་གསུང་སྙན་ཟས་ཀྱིས་གཟི་བརྗིད་བསྐྱེད་བྱས་པ། ། ཐུབ་འོད་ཀྱིས་རྒྱས་པདྨ་ལས་བྱུང་ལུས་མཆོག་ཅན། ། རྒྱལ་བའི་མདུན་གནས་བདེ་གཤེགས་སྲས་སུ་དགེ་བས་འགྱུར། །",
    "gemini_zero_shot": "विशाल, सुगन्धित और शीतल कमल के गर्भ में स्थित,\nजिन के मधुर वचनों रूपी आहार से तेज प्राप्त किये हुए,\nमुनि के प्रकाश से खिले कमल से उत्पन्न उत्तम शरीर वाला,\nकुशल से वह जिन के समक्ष सुगत-पुत्र होता है।"
   }
  ]
